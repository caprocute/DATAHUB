# Sao chép thành .env — không commit .env

COMPOSE_PROJECT_NAME=lgsp

# Postgres
POSTGRES_USER=lgsp
POSTGRES_PASSWORD=lgsp_dev_change_me
POSTGRES_DB=lgsp
POSTGRES_PORT=5432

# Valkey
VALKEY_PORT=6379

# Garage (S3) — ADR-020, không dùng MinIO
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3902
GARAGE_RPC_PORT=3901
# Khóa DEV cố định (chỉ local). Sinh lại trước khi lên staging.
# rpc_secret thật nằm trong deploy/compose/garage/garage.toml (hex 64 ký tự)
GARAGE_ADMIN_TOKEN=dev_admin_token_change_me

# Keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_change_me

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# SeaweedFS S3 — bucket audit WORM (CMP-28); Garage giữ S3 chung
SEAWEED_S3_PORT=8333
SEAWEED_MASTER_PORT=9333

# Thin-slice W1
WIREMOCK_PORT=8089
APISIX_PORT=9080
ADAPTER_MGR_PORT=8082
CAMEL_PORT=8088

# Apps
CONTROL_PORT=8080
CONSOLE_PORT=5173
OIDC_ISSUER_URI=http://localhost:8081/realms/lgsp
JAVA_HOME_OVERRIDE=

# GitOps route publish (WP-23) — không commit token; DEV mặc định chỉ ghi file
LGSP_GITOPS_ROUTES_DIR=routes
LGSP_GITOPS_COMMIT=false
LGSP_GITOPS_AUTHOR_NAME=lgsp-bot
LGSP_GITOPS_AUTHOR_EMAIL=lgsp-bot@local.dev
