{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lgsp.local/schemas/onboarding.system-approved.v1.json",
  "title": "onboarding.system-approved.v1",
  "type": "object",
  "required": ["specversion", "type", "source", "id", "time", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "type": { "const": "onboarding.system-approved.v1" },
    "source": { "type": "string", "format": "uri" },
    "id": { "type": "string" },
    "time": { "type": "string", "format": "date-time" },
    "traceid": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["applicationId", "systemCode", "clientId"],
      "properties": {
        "applicationId": { "type": "string", "format": "uuid" },
        "systemCode": { "type": "string" },
        "clientId": { "type": "string" },
        "approvedBy": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
